{
  "name": "safarcrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --test --experimental-strip-types \"tests/unit/*.test.ts\"",
    "test:db": "supabase test db",
    "import-worker": "node scripts/import-worker.mjs",
    "db:start": "supabase start",
    "db:reset": "node scripts/confirm-reset.mjs && supabase db reset",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "create-boss": "node --env-file=.env.local scripts/create-boss.mjs",
    "seed:history": "node --env-file=.env.local scripts/seed-history.mjs",
    "clean-start": "node --env-file=.env.local scripts/clean-start.mjs",
    "backup": "bash scripts/backup.sh",
    "package": "mkdir -p dist && tar --exclude=./node_modules --exclude=./.next --exclude=./backups --exclude=./dist --exclude=./.git --exclude=\"./.env*\" --exclude=./deploy/supabase-docker --exclude=./deploy/.secrets --exclude=./deploy/.env.production --exclude=./supabase/.temp --exclude=./supabase/.branches -czf dist/safar-crm.tar.gz . && ls -lh dist/safar-crm.tar.gz"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^2.122.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
