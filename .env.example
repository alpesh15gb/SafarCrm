# Supabase project (Settings → API). For local dev, `npx supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public address of the CRM, used in share links and portal invitations
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Ticket import extraction (server only). Without these, imports go to manual review and say what is missing.
# OmniRoute (or any OpenAI-compatible gateway). Use the address the app server reaches it on (e.g. http://127.0.0.1:8088/v1 if on the same machine).
# EXTRACTION_PROVIDER=omniroute
# EXTRACTION_BASE_URL=http://82.112.236.81:8088/v1
# EXTRACTION_API_KEY=
# EXTRACTION_MODEL=APEXV1
# low = fast (about 6–10 s per ticket on APEXV1); "default" sends nothing and lets the gateway decide (30–125 s in tests)
# EXTRACTION_REASONING_EFFORT=low
# Or call Anthropic directly instead:
# EXTRACTION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-opus-5-5   (anthropic only)
# Shared secret for /api/imports/worker (16+ characters); run `npm run import-worker` next to the app
# IMPORT_WORKER_SECRET=
